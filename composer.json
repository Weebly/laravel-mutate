{
    "name": "weebly/laravel-mutate",
    "description": "Mutate Laravel attributes",
    "type": "library",
    "license": "BSD-2-Clause",
    "keywords": ["laravel", "eloquent", "uuid", "encrypt", "database"],
    "require": {
        "php": ">=8.1",
        "ramsey/uuid": "~3.0 || ~4.0",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpstan/phpstan": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Weebly\\Mutate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Weebly\\Mutate\\": ["tests/Unit/", "tests/Integration/"]
        }
    },
    "authors": [
        {
            "name": "Elliot Fehr",
            "email": "elliot@weebly.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Weebly\\Mutate\\LaravelMutatorServiceProvider"
            ]
        }
    }
}
